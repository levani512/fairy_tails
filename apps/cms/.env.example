DATABASE_URL=postgres://fairytails:local-development-only@localhost:5432/fairytails
PAYLOAD_SECRET=replace-with-at-least-32-random-characters
CLIENT_ORIGIN=http://localhost:8081
SERVER_URL=http://localhost:3000
# Optional parent sign-in. Keep all client secrets on the server.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
# Signed Apple client-secret JWT; renew before it expires.
APPLE_CLIENT_SECRET=
# Only honored outside production. Do not expose a development server publicly.
DEV_PREMIUM=false
DEV_COUNTRY=US
# ElevenLabs narration generation and forced alignment (server only).
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_v3
# Optional private S3/R2 bucket. Never make story media publicly readable.
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
